# Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend.
# gmail.com cannot be verified, so this cannot be your gmail address.
# For testing before you own a domain, use: galvanise <onboarding@resend.dev>
WAITLIST_FROM_EMAIL="galvanise <onboarding@resend.dev>"

# Where replies to the confirmation email land. This one can be your gmail.
WAITLIST_REPLY_TO=dhakalshreyas2@gmail.com

# Google Apps Script web app URL that appends rows to your sheet.
# See docs/waitlist.md for the script and deploy steps.
GOOGLE_SHEETS_WEBHOOK_URL=
# Optional shared secret, must match SECRET in the Apps Script.
GOOGLE_SHEETS_WEBHOOK_SECRET=
